<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="GhostFrog\Ebay\Api\AuctionCandidatesInterface" type="GhostFrog\Ebay\Model\Service\AuctionCandidates"/>
    <preference for="GhostFrog\Ebay\Api\SoldComparablesInterface" type="GhostFrog\Ebay\Model\Service\SoldComparables"/>
    <preference for="GhostFrog\Ebay\Api\ListingOutcomesInterface" type="GhostFrog\Ebay\Model\Service\ListingOutcomes"/>
    <preference for="GhostFrog\Ebay\Api\ListingTextInterface" type="GhostFrog\Ebay\Model\Service\ListingText"/>
    <preference for="GhostFrog\Ebay\Api\PricingRulesInterface" type="GhostFrog\Ebay\Model\Service\PricingRules"/>
    <preference for="GhostFrog\Ebay\Api\LocalLlmInterface" type="GhostFrog\Ebay\Model\Service\LocalLlm"/>
    <preference for="GhostFrog\Ebay\Api\SlackInterface" type="GhostFrog\Ebay\Model\Service\SlackText"/>
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="ghostfrog_ebay/listings/gemini_api_key" xsi:type="string">1</item>
                <item name="ghostfrog_ebay/ebay_api/ebay_cert_id" xsi:type="string">1</item>
                <item name="ghostfrog_ebay/ebay_api/ebay_trading_token" xsi:type="string">1</item>
                <item name="ghostfrog_ebay/email/alert_smtp_pass" xsi:type="string">1</item>
                <item name="ghostfrog_ebay/slack/slack_webhook_url" xsi:type="string">1</item>
                <item name="ghostfrog_ebay/slack/slack_bot_token" xsi:type="string">1</item>
                <item name="ghostfrog_ebay/telegram/telegram_bot_token" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Mview\View\Changelog">
        <plugin name="ghostfrog_ebay_changelog_listing_ids" type="GhostFrog\Ebay\Plugin\Mview\ListingIds"/>
    </type>
    <type name="Magento\Framework\Mview\View\ChangelogBatchWalker\IdsTableBuilder">
        <plugin name="ghostfrog_ebay_batch_listing_ids" type="GhostFrog\Ebay\Plugin\Mview\ListingIds"/>
    </type>
    <type name="GhostFrog\Ebay\Model\ModelKey\BrandAliases">
        <arguments>
            <argument name="config" xsi:type="object">Magento\Framework\App\Config\ScopeConfigInterface</argument>
        </arguments>
    </type>
    <type name="GhostFrog\Ebay\Model\ModelKey\Classifier">
        <arguments>
            <argument name="aliases" xsi:type="object">GhostFrog\Ebay\Model\ModelKey\BrandAliases</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="ghostfrog_ebay_api_health" xsi:type="object">GhostFrog\Ebay\Console\Command\ApiHealth</item>
                <item name="ghostfrog_ebay_collect" xsi:type="object">GhostFrog\Ebay\Console\Command\CollectListings</item>
                <item name="ghostfrog_ebay_condition_requeue" xsi:type="object">GhostFrog\Ebay\Console\Command\RequeueCondition</item>
                <item name="ghostfrog_ebay_model_key_rebuild" xsi:type="object">GhostFrog\Ebay\Console\Command\RebuildModelKeys</item>
                <item name="ghostfrog_ebay_rc_reclassify" xsi:type="object">GhostFrog\Ebay\Console\Command\ReclassifyRc</item>
                <item name="ghostfrog_ebay_preview_auction_candidates" xsi:type="object">GhostFrog\Ebay\Console\Command\PreviewAuctionCandidates</item>
            </argument>
        </arguments>
    </type>
</config>
