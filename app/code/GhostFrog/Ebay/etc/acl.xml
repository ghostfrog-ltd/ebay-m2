<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="GhostFrog_Ebay::config" title="Ebay Configuration" translate="title">
                                <resource id="GhostFrog_Ebay::listings" title="Manage eBay Listings" translate="title"/>
                                <resource id="GhostFrog_Ebay::opportunities" title="View eBay Opportunities" translate="title"/>
                                <resource id="GhostFrog_Ebay::sources" title="Manage eBay Sources" translate="title"/>
                                <resource id="GhostFrog_Ebay::tasks" title="Manage GhostFrog Tasks" translate="title"/>
                                <resource id="GhostFrog_Ebay::api_usage" title="View eBay API Usage" translate="title"/>
                            </resource>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
