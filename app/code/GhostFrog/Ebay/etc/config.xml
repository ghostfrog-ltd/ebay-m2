<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <ghostfrog_ebay>
            <general>
                <enabled>0</enabled>
            </general>
            <listings>
                <gemini_api_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
            </listings>
            <ebay_api>
                <oauth_daily_limit>1000</oauth_daily_limit>
                <ebay_cert_id backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <ebay_trading_token backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
            </ebay_api>
            <condition>
                <text_enabled>0</text_enabled>
                <visual_enabled>0</visual_enabled>
                <text_model>qwen3.6:35b-a3b-coding-nvfp4</text_model>
                <visual_model>qwen3.6:35b-a3b-coding-nvfp4</visual_model>
                <batch_size>50</batch_size>
                <text_concurrency>2</text_concurrency>
                <visual_concurrency>1</visual_concurrency>
            </condition>
            <heartbeat>
                <gf_heartbeat_enable_close>0</gf_heartbeat_enable_close>
            </heartbeat>
            <comps>
                <target_profit>50.00</target_profit>
                <selling_fee_percent>13.00</selling_fee_percent>
                <shipping>12.00</shipping>
            </comps>
            <email>
                <alert_smtp_pass backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
            </email>
            <slack>
                <slack_webhook_url backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <slack_bot_token backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
            </slack>
            <telegram>
                <telegram_bot_token backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
            </telegram>
        </ghostfrog_ebay>
    </default>
</config>
