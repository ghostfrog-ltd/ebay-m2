<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ghostfrog_ebay_opportunities.ghostfrog_ebay_opportunities_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>opportunity_columns</spinner>
        <deps>
            <dep>ghostfrog_ebay_opportunities.ghostfrog_ebay_opportunities_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ghostfrog_ebay_opportunities_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">listing_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>GhostFrog_Ebay::opportunities</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="ghostfrog_ebay_opportunities_data_source">
            <settings>
                <requestFieldName>listing_id</requestFieldName>
                <primaryFieldName>listing_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <exportButton name="export_button"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="opportunity_columns" component="GhostFrog_Ebay/js/grid/source-colour-listing">
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>listing_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="listing_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Listing ID</label>
            </settings>
        </column>
        <column name="title" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Title</label>
            </settings>
        </column>
        <column name="ebay_listing_url" component="GhostFrog_Ebay/js/grid/columns/view-link" sortOrder="25">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="link" xsi:type="string">ebay_listing_url</item>
                </item>
            </argument>
            <settings>
                <sortable>false</sortable>
                <label translate="true">eBay</label>
            </settings>
        </column>
        <column name="source" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <options class="GhostFrog\Ebay\Ui\Component\Opportunities\Column\Sources"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Source</label>
            </settings>
        </column>
        <column name="sale_type" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="GhostFrog\Ebay\Ui\Component\Opportunities\Column\SaleTypes"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Sale Type</label>
            </settings>
        </column>
        <column name="best_offer" component="Magento_Ui/js/grid/columns/select" sortOrder="45">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Best Offer</label>
            </settings>
        </column>
        <column name="model_key" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Model Key</label>
            </settings>
        </column>
        <column name="is_accessory" component="Magento_Ui/js/grid/columns/select" sortOrder="55">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Accessory</label>
            </settings>
        </column>
        <column name="condition_grade" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Condition Grade</label>
            </settings>
        </column>
        <column name="llm_graded_text" component="Magento_Ui/js/grid/columns/select" sortOrder="61">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">LLM Graded Text</label>
            </settings>
        </column>
        <column name="llm_graded_visual" component="Magento_Ui/js/grid/columns/select" sortOrder="62">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">LLM Graded Images</label>
            </settings>
        </column>
        <column name="checks_pending" component="Magento_Ui/js/grid/columns/select" sortOrder="63">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Checks Pending</label>
            </settings>
        </column>
        <column name="current_price" sortOrder="70">
            <settings>
                <fieldClass>
                    <class name="gf-strong">true</class>
                </fieldClass>
                <filter>textRange</filter>
                <label translate="true">Price £</label>
            </settings>
        </column>
        <column name="sold_median" sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Median £</label>
            </settings>
        </column>
        <column name="shipping" sortOrder="85">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Ship £</label>
            </settings>
        </column>
        <column name="comp_count" sortOrder="90">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Comps</label>
            </settings>
        </column>
        <column name="max_safe_buy" sortOrder="100">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Max Buy £</label>
            </settings>
        </column>
        <column name="headroom" sortOrder="105">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Headroom £</label>
            </settings>
        </column>
        <column name="expected_profit" sortOrder="110">
            <settings>
                <fieldClass>
                    <class name="gf-strong">true</class>
                </fieldClass>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <label translate="true">Profit £</label>
            </settings>
        </column>
        <column name="expected_roi_percent" sortOrder="120">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Expected ROI (%)</label>
            </settings>
        </column>
        <column name="end_time" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="130">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">End Time</label>
            </settings>
        </column>
        <column name="last_price_checked_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="135">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Last Price Checked</label>
            </settings>
        </column>
        <column name="price_freshness" class="GhostFrog\Ebay\Ui\Component\Opportunities\Column\PriceFreshness" sortOrder="136">
            <settings>
                <sortable>false</sortable>
                <label translate="true">Price Freshness</label>
            </settings>
        </column>
        <column name="bid_price" sortOrder="137">
            <settings>
                <visible>false</visible>
                <filter>textRange</filter>
                <label translate="true">Bid £</label>
            </settings>
        </column>
        <column name="bin_price" sortOrder="138">
            <settings>
                <visible>false</visible>
                <filter>textRange</filter>
                <label translate="true">BIN £</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="GhostFrog\Ebay\Ui\Component\Opportunities\Column\Actions" sortOrder="140">
            <settings>
                <indexField>listing_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
