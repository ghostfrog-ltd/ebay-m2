<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ghostfrog_ebay_api_usage.ghostfrog_ebay_api_usage_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>api_usage_columns</spinner>
        <deps>
            <dep>ghostfrog_ebay_api_usage.ghostfrog_ebay_api_usage_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ghostfrog_ebay_api_usage_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">api</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>GhostFrog_Ebay::api_usage</aclResource>
        <dataProvider class="GhostFrog\Ebay\Model\Api\UsageDataProvider"
                      name="ghostfrog_ebay_api_usage_data_source">
            <settings>
                <requestFieldName>api</requestFieldName>
                <primaryFieldName>api</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <columnsControls name="columns_controls"/>
    </listingToolbar>
    <columns name="api_usage_columns">
        <column name="api_name" sortOrder="10">
            <settings>
                <label translate="true">eBay API</label>
            </settings>
        </column>
        <column name="date" sortOrder="15">
            <settings>
                <label translate="true">Day (UTC)</label>
            </settings>
        </column>
        <column name="calls_today" sortOrder="20">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Magento Calls Today</label>
            </settings>
        </column>
        <column name="daily_limit" sortOrder="30">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Daily Limit</label>
            </settings>
        </column>
        <column name="remaining" sortOrder="40">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Remaining</label>
            </settings>
        </column>
        <column name="used_percent" sortOrder="50">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Used %</label>
            </settings>
        </column>
        <column name="reported_remaining" sortOrder="60">
            <settings>
                <dataType>number</dataType>
                <label translate="true">eBay Remaining at Last Check</label>
            </settings>
        </column>
        <column name="checked_at" sortOrder="70">
            <settings>
                <label translate="true">Last Checked</label>
            </settings>
        </column>
        <column name="reset_at" sortOrder="80">
            <settings>
                <label translate="true">eBay Resets</label>
            </settings>
        </column>
        <column name="status" sortOrder="90">
            <settings>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="retry_at" sortOrder="100">
            <settings>
                <label translate="true">Retry At</label>
            </settings>
        </column>
        <column name="services" sortOrder="110">
            <settings>
                <sortable>false</sortable>
                <label translate="true">Calls by Service</label>
            </settings>
        </column>
    </columns>
</listing>
