<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ghostfrog_ebay_listing.ghostfrog_ebay_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>listing_columns</spinner>
        <deps>
            <dep>ghostfrog_ebay_listing.ghostfrog_ebay_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ghostfrog_ebay_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>GhostFrog_Ebay::listings</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="ghostfrog_ebay_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="listing_columns" component="GhostFrog_Ebay/js/grid/source-colour-listing">
        <column name="id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="title" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Title</label>
            </settings>
        </column>
        <column name="external_id" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">eBay Item ID</label>
            </settings>
        </column>
        <column name="source" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="GhostFrog\Ebay\Ui\Component\Listing\Column\Sources"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Source</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="GhostFrog\Ebay\Ui\Component\Listing\Column\Statuses"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="sale_type" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="GhostFrog\Ebay\Ui\Component\Opportunities\Column\SaleTypes"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Sale Type</label>
            </settings>
        </column>
        <column name="price_current" sortOrder="70">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Current Price (GBP)</label>
            </settings>
        </column>
        <column name="bids_count" sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Bids</label>
            </settings>
        </column>
        <column name="end_time" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">End Time</label>
            </settings>
        </column>
        <column name="model_key" sortOrder="100">
            <settings>
                <filter>text</filter>
                <label translate="true">Model Key</label>
            </settings>
        </column>
        <column name="item_type" component="Magento_Ui/js/grid/columns/select" sortOrder="102">
            <settings>
                <options class="GhostFrog\Ebay\Model\Config\Source\RcItemTypes"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <visible>false</visible>
                <label translate="true">Item Type</label>
            </settings>
        </column>
        <column name="key_source" sortOrder="104">
            <settings>
                <filter>text</filter>
                <visible>false</visible>
                <label translate="true">Key From</label>
            </settings>
        </column>
        <column name="condition_grade" component="Magento_Ui/js/grid/columns/select" sortOrder="110">
            <settings>
                <options class="GhostFrog\Ebay\Ui\Component\Listing\Column\ConditionGrades"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Condition Grade</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="GhostFrog\Ebay\Ui\Component\Listing\Column\Actions" sortOrder="120">
            <settings>
                <indexField>id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
