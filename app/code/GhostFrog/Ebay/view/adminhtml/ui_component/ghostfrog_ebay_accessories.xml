<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ghostfrog_ebay_accessories.ghostfrog_ebay_accessories_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>accessory_columns</spinner>
        <deps>
            <dep>ghostfrog_ebay_accessories.ghostfrog_ebay_accessories_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ghostfrog_ebay_accessories_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>GhostFrog_Ebay::opportunities</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="ghostfrog_ebay_accessories_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <exportButton name="export_button"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="accessory_columns">
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>id</indexField>
            </settings>
        </selectionsColumn>
        <column name="id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Listing ID</label>
            </settings>
        </column>
        <column name="title" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Title</label>
            </settings>
        </column>
        <column name="ebay_listing_url" component="GhostFrog_Ebay/js/grid/columns/view-link" sortOrder="25">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="link" xsi:type="string">ebay_listing_url</item>
                </item>
            </argument>
            <settings>
                <sortable>false</sortable>
                <label translate="true">eBay</label>
            </settings>
        </column>
        <column name="platform" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <options class="GhostFrog\Ebay\Model\Config\Source\AccessoryPlatforms"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Console</label>
            </settings>
        </column>
        <column name="kind" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Kind</label>
            </settings>
        </column>
        <column name="model_key" sortOrder="50">
            <settings>
                <filter>text</filter>
                <visible>false</visible>
                <label translate="true">Model Key</label>
            </settings>
        </column>
        <column name="condition_grade" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Condition Grade</label>
            </settings>
        </column>
        <column name="sale_type" sortOrder="65">
            <settings>
                <filter>text</filter>
                <label translate="true">Sale Type</label>
            </settings>
        </column>
        <column name="price" sortOrder="70">
            <settings>
                <fieldClass>
                    <class name="gf-strong">true</class>
                </fieldClass>
                <filter>textRange</filter>
                <label translate="true">Price £</label>
            </settings>
        </column>
        <column name="sold_median" sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Median £</label>
            </settings>
        </column>
        <column name="comp_count" sortOrder="90">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Comps</label>
            </settings>
        </column>
        <column name="saving" sortOrder="100">
            <settings>
                <fieldClass>
                    <class name="gf-strong">true</class>
                </fieldClass>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <label translate="true">Below Median £</label>
            </settings>
        </column>
        <column name="end_time" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="110">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">End Time</label>
            </settings>
        </column>
    </columns>
</listing>
