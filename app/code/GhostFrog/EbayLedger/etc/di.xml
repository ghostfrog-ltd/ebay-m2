<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="ghostfrog_ledger_import_purchases" xsi:type="object">GhostFrog\EbayLedger\Console\Command\ImportPurchases</item>
                <item name="ghostfrog_ledger_import_sales" xsi:type="object">GhostFrog\EbayLedger\Console\Command\ImportSales</item>
            </argument>
        </arguments>
    </type>
    <type name="GhostFrog\EbayLedger\Console\Command\ImportPurchases">
        <arguments>
            <argument name="all" xsi:type="object">GhostFrog\EbayLedger\Model\Purchase\ImportAll\Proxy</argument>
            <argument name="importer" xsi:type="object">GhostFrog\EbayLedger\Model\Purchase\Importer\Proxy</argument>
            <argument name="tokens" xsi:type="object">GhostFrog\EbayLedger\Model\Account\Tokens\Proxy</argument>
        </arguments>
    </type>
    <virtualType name="GhostFrog\EbayLedger\Model\StockUnit\PhotoUploader" type="Magento\Catalog\Model\ImageUploader">
        <arguments>
            <argument name="baseTmpPath" xsi:type="string">ghostfrog_ledger/tmp</argument>
            <argument name="basePath" xsi:type="string">ghostfrog_ledger/stock</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="png" xsi:type="string">png</item>
                <item name="gif" xsi:type="string">gif</item>
                <item name="webp" xsi:type="string">webp</item>
            </argument>
            <argument name="allowedMimeTypes" xsi:type="array">
                <item name="jpg" xsi:type="string">image/jpg</item>
                <item name="jpeg" xsi:type="string">image/jpeg</item>
                <item name="png" xsi:type="string">image/png</item>
                <item name="gif" xsi:type="string">image/gif</item>
                <item name="webp" xsi:type="string">image/webp</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="GhostFrog\EbayLedger\Model\StockUnit\Photos">
        <arguments>
            <argument name="uploader" xsi:type="object">GhostFrog\EbayLedger\Model\StockUnit\PhotoUploader</argument>
        </arguments>
    </type>
    <type name="GhostFrog\EbayLedger\Controller\Adminhtml\StockUnit\Upload">
        <arguments>
            <argument name="uploader" xsi:type="object">GhostFrog\EbayLedger\Model\StockUnit\PhotoUploader</argument>
        </arguments>
    </type>
    <type name="GhostFrog\EbayLedger\Console\Command\ImportSales">
        <arguments>
            <argument name="all" xsi:type="object">GhostFrog\EbayLedger\Model\Sale\ImportAll\Proxy</argument>
            <argument name="importer" xsi:type="object">GhostFrog\EbayLedger\Model\Sale\Importer\Proxy</argument>
            <argument name="tokens" xsi:type="object">GhostFrog\EbayLedger\Model\Account\Tokens\Proxy</argument>
        </arguments>
    </type>
    <type name="GhostFrog\EbayLedger\Model\Carrier\Postage" shared="true"/>
</config>
