<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ghostfrog_ebayledger_account" resource="default" engine="innodb" comment="Connected eBay accounts">
        <column xsi:type="int" name="account_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="label" length="100" nullable="false"/>
        <column xsi:type="varchar" name="role" length="10" nullable="false" default="both" comment="buyer, seller or both"/>
        <column xsi:type="smallint" name="enabled" unsigned="true" nullable="false" default="1"/>
        <column xsi:type="varchar" name="status" length="20" nullable="false" default="not_connected"/>
        <column xsi:type="varchar" name="ebay_username" length="64" nullable="true"/>
        <column xsi:type="varchar" name="ebay_user_id" length="64" nullable="true"/>
        <column xsi:type="text" name="access_token" nullable="true" comment="Encrypted"/>
        <column xsi:type="datetime" name="access_expires_at" nullable="true" comment="UTC"/>
        <column xsi:type="text" name="refresh_token" nullable="true" comment="Encrypted"/>
        <column xsi:type="datetime" name="refresh_expires_at" nullable="true" comment="UTC"/>
        <column xsi:type="text" name="scopes" nullable="true"/>
        <column xsi:type="datetime" name="connected_at" nullable="true" comment="UTC"/>
        <column xsi:type="text" name="last_error" nullable="true"/>
        <column xsi:type="datetime" name="purchases_imported_at" nullable="true" comment="UTC, last successful import"/>
        <column xsi:type="datetime" name="sales_imported_at" nullable="true" comment="UTC, last successful sales import"/>
        <column xsi:type="datetime" name="finances_imported_at" nullable="true" comment="UTC, last successful fees and payouts import"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="account_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="GHOSTFROG_EBAYLEDGER_ACCOUNT_EBAY_USER_ID">
            <column name="ebay_user_id"/>
        </constraint>
    </table>
    <table name="ghostfrog_ebayledger_stock_unit" resource="default" engine="innodb" comment="Real items bought on eBay">
        <column xsi:type="int" name="stock_unit_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="reference" length="32" nullable="true" comment="GF-000001, set once"/>
        <column xsi:type="int" name="account_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="ebay_order_id" length="64" nullable="false"/>
        <column xsi:type="varchar" name="ebay_line_item_id" length="64" nullable="false" comment="OrderLineItemID"/>
        <column xsi:type="varchar" name="ebay_transaction_id" length="32" nullable="true"/>
        <column xsi:type="varchar" name="ebay_item_id" length="32" nullable="false"/>
        <column xsi:type="smallint" name="unit_index" unsigned="true" nullable="false" default="1" comment="1..quantity bought on the line"/>
        <column xsi:type="smallint" name="line_quantity" unsigned="true" nullable="false" default="1"/>
        <column xsi:type="varchar" name="title" length="255" nullable="false"/>
        <column xsi:type="varchar" name="currency" length="3" nullable="false" default="GBP"/>
        <column xsi:type="decimal" name="item_price" scale="2" precision="12" nullable="false" default="0"/>
        <column xsi:type="decimal" name="postage_paid" scale="2" precision="12" nullable="false" default="0"/>
        <column xsi:type="decimal" name="other_costs" scale="2" precision="12" nullable="false" default="0" comment="Buyer protection and other charges on the order"/>
        <column xsi:type="decimal" name="total_cost" scale="2" precision="12" nullable="false" default="0"/>
        <column xsi:type="varchar" name="purchase_method" length="20" nullable="false" default="unknown"/>
        <column xsi:type="varchar" name="purchase_method_source" length="10" nullable="true" comment="ebay or manual"/>
        <column xsi:type="datetime" name="purchased_at" nullable="false" comment="UTC"/>
        <column xsi:type="datetime" name="paid_at" nullable="true" comment="UTC"/>
        <column xsi:type="datetime" name="shipped_at" nullable="true" comment="UTC"/>
        <column xsi:type="varchar" name="ebay_order_status" length="32" nullable="true"/>
        <column xsi:type="varchar" name="status" length="20" nullable="false" default="purchased"/>
        <column xsi:type="bigint" name="listing_id" unsigned="true" nullable="true" comment="Core listing, when core collected it"/>
        <column xsi:type="varchar" name="model_key" length="255" nullable="true"/>
        <column xsi:type="varchar" name="predicted_grade" length="10" nullable="true"/>
        <column xsi:type="decimal" name="predicted_resale" scale="2" precision="12" nullable="true"/>
        <column xsi:type="int" name="predicted_comp_count" unsigned="true" nullable="true"/>
        <column xsi:type="json" name="prediction" nullable="true" comment="Core's view of the item when imported"/>
        <column xsi:type="json" name="raw_payload" nullable="true" comment="eBay order, personal details removed"/>
        <column xsi:type="date" name="received_at" nullable="true"/>
        <column xsi:type="varchar" name="actual_grade" length="10" nullable="true" comment="Your grade once it arrived"/>
        <column xsi:type="json" name="contents" nullable="true" comment="Parts that arrived, as a list"/>
        <column xsi:type="text" name="faults" nullable="true"/>
        <column xsi:type="text" name="notes" nullable="true"/>
        <column xsi:type="json" name="photos" nullable="true" comment="Files under pub/media/ghostfrog_ledger/stock"/>
        <column xsi:type="decimal" name="refund_amount" scale="2" precision="12" nullable="false" default="0" comment="Refunded by the seller"/>
        <column xsi:type="date" name="refunded_at" nullable="true"/>
        <column xsi:type="datetime" name="inspected_at" nullable="true" comment="UTC, when the receive form was last saved"/>
        <column xsi:type="datetime" name="imported_at" nullable="false" comment="UTC"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="stock_unit_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="GHOSTFROG_EBAYLEDGER_STOCK_UNIT_REFERENCE">
            <column name="reference"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="GHOSTFROG_EBAYLEDGER_STOCK_UNIT_EBAY_LINE_UNIT">
            <column name="ebay_order_id"/>
            <column name="ebay_line_item_id"/>
            <column name="unit_index"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="GHOSTFROG_EBAYLEDGER_STOCK_UNIT_ACCOUNT"
                    table="ghostfrog_ebayledger_stock_unit" column="account_id"
                    referenceTable="ghostfrog_ebayledger_account" referenceColumn="account_id" onDelete="NO ACTION"/>
        <index referenceId="GHOSTFROG_EBAYLEDGER_STOCK_UNIT_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="GHOSTFROG_EBAYLEDGER_STOCK_UNIT_PURCHASED_AT" indexType="btree">
            <column name="purchased_at"/>
        </index>
        <index referenceId="GHOSTFROG_EBAYLEDGER_STOCK_UNIT_ITEM" indexType="btree">
            <column name="ebay_item_id"/>
        </index>
    </table>
    <table name="ghostfrog_ebayledger_import_run" resource="default" engine="innodb" comment="eBay import runs">
        <column xsi:type="int" name="run_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="account_id" unsigned="true" nullable="true"/>
        <column xsi:type="varchar" name="kind" length="20" nullable="false" comment="purchases, sales, finances"/>
        <column xsi:type="varchar" name="trigger" length="10" nullable="false" comment="cron, manual or cli"/>
        <column xsi:type="varchar" name="status" length="10" nullable="false" default="running"/>
        <column xsi:type="datetime" name="window_from" nullable="true" comment="UTC"/>
        <column xsi:type="datetime" name="window_to" nullable="true" comment="UTC"/>
        <column xsi:type="int" name="fetched" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="int" name="created" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="int" name="updated" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="text" name="message" nullable="true"/>
        <column xsi:type="datetime" name="started_at" nullable="false" comment="UTC"/>
        <column xsi:type="datetime" name="finished_at" nullable="true" comment="UTC"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="run_id"/>
        </constraint>
        <index referenceId="GHOSTFROG_EBAYLEDGER_IMPORT_RUN_ACCOUNT_KIND" indexType="btree">
            <column name="account_id"/>
            <column name="kind"/>
        </index>
    </table>
    <table name="ghostfrog_ebayledger_parts_template" resource="default" engine="innodb" comment="Sellable parts per model">
        <column xsi:type="int" name="template_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="name" length="100" nullable="false"/>
        <column xsi:type="text" name="model_keys" nullable="false" comment="Core model keys it applies to, one per line"/>
        <column xsi:type="json" name="parts" nullable="true" comment="name, group, size_band, comp_model_key, estimate"/>
        <column xsi:type="varchar" name="whole_size_band" length="20" nullable="false" default="large"/>
        <column xsi:type="smallint" name="active" unsigned="true" nullable="false" default="1"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="template_id"/>
        </constraint>
    </table>
    <table name="ghostfrog_ebayledger_sell_plan" resource="default" engine="innodb" comment="How a stock unit will be sold">
        <column xsi:type="int" name="plan_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="stock_unit_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="status" length="12" nullable="false" default="draft" comment="draft, confirmed, superseded"/>
        <column xsi:type="varchar" name="chosen_option" length="12" nullable="true" comment="whole, part_out or mixed"/>
        <column xsi:type="varchar" name="recommended_option" length="12" nullable="true"/>
        <column xsi:type="json" name="inputs" nullable="true" comment="Parts present and your price overrides"/>
        <column xsi:type="json" name="options" nullable="true" comment="Every option as estimated, kept for actual vs planned"/>
        <column xsi:type="int" name="template_id" unsigned="true" nullable="true"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <column xsi:type="datetime" name="confirmed_at" nullable="true" comment="UTC"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="plan_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="GHOSTFROG_EBAYLEDGER_SELL_PLAN_UNIT"
                    table="ghostfrog_ebayledger_sell_plan" column="stock_unit_id"
                    referenceTable="ghostfrog_ebayledger_stock_unit" referenceColumn="stock_unit_id" onDelete="NO ACTION"/>
        <index referenceId="GHOSTFROG_EBAYLEDGER_SELL_PLAN_UNIT_STATUS" indexType="btree">
            <column name="stock_unit_id"/>
            <column name="status"/>
        </index>
    </table>
    <table name="ghostfrog_ebayledger_product" resource="default" engine="innodb" comment="Magento products made from stock units">
        <column xsi:type="int" name="ledger_product_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="stock_unit_id" unsigned="true" nullable="false"/>
        <column xsi:type="int" name="plan_id" unsigned="true" nullable="false"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="true" comment="Magento product; null once replaced"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false"/>
        <column xsi:type="smallint" name="line_number" unsigned="true" nullable="false" comment="0 when sold whole"/>
        <column xsi:type="varchar" name="part_name" length="255" nullable="false"/>
        <column xsi:type="json" name="parts" nullable="true" comment="Template parts in this product"/>
        <column xsi:type="decimal" name="planned_price" scale="2" precision="12" nullable="false" default="0"/>
        <column xsi:type="decimal" name="allocated_cost" scale="2" precision="12" nullable="false" default="0"/>
        <column xsi:type="varchar" name="status" length="12" nullable="false" default="active" comment="active, sold, replaced"/>
        <column xsi:type="varchar" name="ebay_item_id" length="32" nullable="true" comment="Once listed"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="ledger_product_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="GHOSTFROG_EBAYLEDGER_PRODUCT_UNIT"
                    table="ghostfrog_ebayledger_product" column="stock_unit_id"
                    referenceTable="ghostfrog_ebayledger_stock_unit" referenceColumn="stock_unit_id" onDelete="NO ACTION"/>
        <index referenceId="GHOSTFROG_EBAYLEDGER_PRODUCT_SKU" indexType="btree">
            <column name="sku"/>
        </index>
        <index referenceId="GHOSTFROG_EBAYLEDGER_PRODUCT_UNIT_STATUS" indexType="btree">
            <column name="stock_unit_id"/>
            <column name="status"/>
        </index>
    </table>
    <table name="ghostfrog_ebayledger_sale_line" resource="default" engine="innodb" comment="eBay sales, one row per order line">
        <column xsi:type="int" name="sale_line_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="account_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="ebay_order_id" length="64" nullable="false"/>
        <column xsi:type="varchar" name="ebay_line_item_id" length="64" nullable="false"/>
        <column xsi:type="varchar" name="ebay_item_id" length="32" nullable="true" comment="legacyItemId"/>
        <column xsi:type="varchar" name="sku" length="80" nullable="true" comment="The listing's custom label"/>
        <column xsi:type="varchar" name="title" length="255" nullable="false"/>
        <column xsi:type="smallint" name="quantity" unsigned="true" nullable="false" default="1"/>
        <column xsi:type="varchar" name="currency" length="3" nullable="false" default="GBP"/>
        <column xsi:type="decimal" name="line_price" scale="2" precision="12" nullable="false" default="0" comment="What the buyer paid for the item(s)"/>
        <column xsi:type="decimal" name="postage" scale="2" precision="12" nullable="false" default="0" comment="Postage the buyer paid for this line"/>
        <column xsi:type="decimal" name="refunded" scale="2" precision="12" nullable="false" default="0" comment="Refunded to the buyer on this line"/>
        <column xsi:type="datetime" name="sold_at" nullable="false" comment="UTC"/>
        <column xsi:type="varchar" name="payment_status" length="32" nullable="true"/>
        <column xsi:type="varchar" name="fulfillment_status" length="32" nullable="true"/>
        <column xsi:type="smallint" name="cancelled" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="varchar" name="match_status" length="12" nullable="false" default="unmatched" comment="matched, linked, unmatched, ignored"/>
        <column xsi:type="varchar" name="match_note" length="255" nullable="true"/>
        <column xsi:type="int" name="ledger_product_id" unsigned="true" nullable="true"/>
        <column xsi:type="int" name="magento_order_id" unsigned="true" nullable="true"/>
        <column xsi:type="smallint" name="shipped" unsigned="true" nullable="false" default="0" comment="Magento shipment created"/>
        <column xsi:type="json" name="raw_payload" nullable="true" comment="eBay order, personal details removed"/>
        <column xsi:type="text" name="last_error" nullable="true"/>
        <column xsi:type="datetime" name="imported_at" nullable="false" comment="UTC"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="sale_line_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="GHOSTFROG_EBAYLEDGER_SALE_LINE_EBAY_LINE">
            <column name="ebay_order_id"/>
            <column name="ebay_line_item_id"/>
        </constraint>
        <index referenceId="GHOSTFROG_EBAYLEDGER_SALE_LINE_MATCH" indexType="btree">
            <column name="match_status"/>
        </index>
        <index referenceId="GHOSTFROG_EBAYLEDGER_SALE_LINE_PRODUCT" indexType="btree">
            <column name="ledger_product_id"/>
        </index>
        <index referenceId="GHOSTFROG_EBAYLEDGER_SALE_LINE_ORDER" indexType="btree">
            <column name="magento_order_id"/>
        </index>
    </table>
    <table name="ghostfrog_ebayledger_signing_key" resource="default" engine="innodb" comment="eBay request signing keys (Key Management API)">
        <column xsi:type="varchar" name="signing_key_id" length="64" nullable="false"/>
        <column xsi:type="varchar" name="cipher" length="16" nullable="false" default="ED25519"/>
        <column xsi:type="text" name="jwe" nullable="false" comment="Sent as x-ebay-signature-key"/>
        <column xsi:type="text" name="private_key" nullable="false" comment="Encrypted"/>
        <column xsi:type="datetime" name="expires_at" nullable="true" comment="UTC"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="signing_key_id"/>
        </constraint>
    </table>
    <table name="ghostfrog_ebayledger_fee" resource="default" engine="innodb" comment="eBay fees, charges and credits from the Finances API">
        <column xsi:type="int" name="fee_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="account_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="fee_key" length="190" nullable="false" comment="Transaction type, ID, line and fee type: unique"/>
        <column xsi:type="varchar" name="transaction_id" length="64" nullable="false"/>
        <column xsi:type="varchar" name="transaction_type" length="32" nullable="false"/>
        <column xsi:type="varchar" name="fee_type" length="64" nullable="false"/>
        <column xsi:type="decimal" name="amount" scale="2" precision="12" nullable="false" default="0" comment="Positive costs you, negative is a credit"/>
        <column xsi:type="varchar" name="currency" length="3" nullable="false" default="GBP"/>
        <column xsi:type="datetime" name="booked_at" nullable="false" comment="UTC"/>
        <column xsi:type="varchar" name="ebay_order_id" length="64" nullable="true"/>
        <column xsi:type="varchar" name="ebay_line_item_id" length="64" nullable="true"/>
        <column xsi:type="varchar" name="payout_id" length="64" nullable="true"/>
        <column xsi:type="int" name="sale_line_id" unsigned="true" nullable="true"/>
        <column xsi:type="int" name="ledger_product_id" unsigned="true" nullable="true"/>
        <column xsi:type="int" name="magento_order_id" unsigned="true" nullable="true"/>
        <column xsi:type="json" name="raw_payload" nullable="true" comment="eBay transaction, personal details removed"/>
        <column xsi:type="datetime" name="imported_at" nullable="false" comment="UTC"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="fee_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="GHOSTFROG_EBAYLEDGER_FEE_KEY">
            <column name="fee_key"/>
        </constraint>
        <index referenceId="GHOSTFROG_EBAYLEDGER_FEE_ORDER" indexType="btree">
            <column name="ebay_order_id"/>
        </index>
        <index referenceId="GHOSTFROG_EBAYLEDGER_FEE_PRODUCT" indexType="btree">
            <column name="ledger_product_id"/>
        </index>
    </table>
    <table name="ghostfrog_ebayledger_payout" resource="default" engine="innodb" comment="eBay payouts to your bank">
        <column xsi:type="varchar" name="payout_id" length="64" nullable="false"/>
        <column xsi:type="int" name="account_id" unsigned="true" nullable="false"/>
        <column xsi:type="decimal" name="amount" scale="2" precision="12" nullable="false" default="0"/>
        <column xsi:type="varchar" name="currency" length="3" nullable="false" default="GBP"/>
        <column xsi:type="varchar" name="status" length="32" nullable="true"/>
        <column xsi:type="datetime" name="payout_at" nullable="true" comment="UTC"/>
        <column xsi:type="datetime" name="imported_at" nullable="false" comment="UTC"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="payout_id"/>
        </constraint>
    </table>
    <table name="ghostfrog_ebayledger_sale_payout" resource="default" engine="innodb" comment="Which payout carried each sale">
        <column xsi:type="varchar" name="transaction_id" length="64" nullable="false"/>
        <column xsi:type="varchar" name="ebay_order_id" length="64" nullable="false"/>
        <column xsi:type="varchar" name="payout_id" length="64" nullable="true"/>
        <column xsi:type="decimal" name="net_amount" scale="2" precision="12" nullable="false" default="0" comment="What eBay credited you for the order"/>
        <column xsi:type="datetime" name="booked_at" nullable="false" comment="UTC"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="transaction_id"/>
        </constraint>
        <index referenceId="GHOSTFROG_EBAYLEDGER_SALE_PAYOUT_ORDER" indexType="btree">
            <column name="ebay_order_id"/>
        </index>
    </table>
    <table name="ghostfrog_ebayledger_cost" resource="default" engine="innodb" comment="Costs you enter: packaging, your own postage, repairs">
        <column xsi:type="int" name="cost_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="stock_unit_id" unsigned="true" nullable="false"/>
        <column xsi:type="int" name="ledger_product_id" unsigned="true" nullable="true" comment="Empty when the cost is for the whole unit"/>
        <column xsi:type="varchar" name="cost_type" length="20" nullable="false" comment="packaging, postage, repair, other"/>
        <column xsi:type="decimal" name="amount" scale="2" precision="12" nullable="false" default="0"/>
        <column xsi:type="date" name="incurred_on" nullable="false"/>
        <column xsi:type="varchar" name="note" length="255" nullable="true"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="cost_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="GHOSTFROG_EBAYLEDGER_COST_UNIT"
                    table="ghostfrog_ebayledger_cost" column="stock_unit_id"
                    referenceTable="ghostfrog_ebayledger_stock_unit" referenceColumn="stock_unit_id" onDelete="NO ACTION"/>
    </table>
</schema>
