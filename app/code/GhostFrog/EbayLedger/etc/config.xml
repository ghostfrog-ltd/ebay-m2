<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <ghostfrog_ebay>
            <ledger_connection>
                <runame></runame>
                <scopes>https://api.ebay.com/oauth/api_scope
https://api.ebay.com/oauth/api_scope/commerce.identity.readonly
https://api.ebay.com/oauth/api_scope/sell.fulfillment.readonly
https://api.ebay.com/oauth/api_scope/sell.finances
https://api.ebay.com/oauth/api_scope/sell.order.read
https://api.ebay.com/oauth/api_scope/sell.cancellation.read
https://api.ebay.com/oauth/api_scope/sell.return.read
https://api.ebay.com/oauth/api_scope/sell.refund.read</scopes>
            </ledger_connection>
            <ledger_import>
                <enabled>1</enabled>
                <cron_expr>*/30 * * * *</cron_expr>
                <first_run_days>90</first_run_days>
                <refresh_days>30</refresh_days>
            </ledger_import>
            <ledger_sell>
                <effort_cost>2.00</effort_cost>
                <per_order_fee>0.00</per_order_fee>
                <packaging>1.50</packaging>
                <postage>small:3.20
medium:4.50
large:7.50</postage>
                <min_confidence>medium</min_confidence>
                <comps_days>365</comps_days>
            </ledger_sell>
            <ledger_orders>
                <tax_class_id>0</tax_class_id>
                <order_status>processing</order_status>
            </ledger_orders>
            <ledger_products>
                <sku_prefix>GF-</sku_prefix>
            </ledger_products>
        </ghostfrog_ebay>
        <payment>
            <ebay>
                <active>1</active>
                <model>GhostFrog\EbayLedger\Model\Payment\Ebay</model>
                <title>eBay</title>
                <order_status>pending</order_status>
                <allowspecific>0</allowspecific>
                <group>offline</group>
            </ebay>
        </payment>
        <carriers>
            <ebayshipping>
                <active>1</active>
                <model>GhostFrog\EbayLedger\Model\Carrier\EbayShipping</model>
                <title>eBay shipping</title>
                <name>eBay</name>
                <sallowspecific>0</sallowspecific>
                <showmethod>0</showmethod>
            </ebayshipping>
        </carriers>
    </default>
</config>
