<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ghostfrog_ebayledger_cost_form.ghostfrog_ebayledger_cost_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Cost</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="GhostFrog\EbayLedger\Block\Adminhtml\Template\BackButton"/>
            <button name="save" class="GhostFrog\EbayLedger\Block\Adminhtml\StockUnit\SaveButton"/>
        </buttons>
        <namespace>ghostfrog_ebayledger_cost_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>ghostfrog_ebayledger_cost_form.ghostfrog_ebayledger_cost_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ghostfrog_ebayledger_cost_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="ghostfrog_ledger/cost/save"/>
        </settings>
        <aclResource>GhostFrog_EbayLedger::dashboard</aclResource>
        <dataProvider class="GhostFrog\EbayLedger\Model\Cost\DataProvider" name="ghostfrog_ebayledger_cost_form_data_source">
            <settings>
                <requestFieldName>cost_id</requestFieldName>
                <primaryFieldName>cost_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Cost</label>
        </settings>
        <field name="cost_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>cost_id</dataScope>
            </settings>
        </field>
        <field name="stock_unit_id" formElement="select" sortOrder="10">
            <settings>
                <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                <dataType>text</dataType>
                <label translate="true">Stock Unit</label>
                <dataScope>stock_unit_id</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="GhostFrog\EbayLedger\Model\Cost\UnitOptions"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="ledger_product_id" formElement="select" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Product (optional)</label>
                <dataScope>ledger_product_id</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="GhostFrog\EbayLedger\Model\Cost\ProductOptions"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="cost_type" formElement="select" sortOrder="30">
            <settings>
                <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                <dataType>text</dataType>
                <label translate="true">Kind</label>
                <dataScope>cost_type</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="GhostFrog\EbayLedger\Model\Cost\CostType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="amount" formElement="input" sortOrder="40">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-greater-than-zero" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Amount (GBP)</label>
                <dataScope>amount</dataScope>
            </settings>
        </field>
        <field name="incurred_on" formElement="date" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Date</label>
                <dataScope>incurred_on</dataScope>
            </settings>
            <formElements>
                <date>
                    <settings>
                        <inputDateFormat>y-MM-dd</inputDateFormat>
                        <outputDateFormat>y-MM-dd</outputDateFormat>
                    </settings>
                </date>
            </formElements>
        </field>
        <field name="note" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Note</label>
                <dataScope>note</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
