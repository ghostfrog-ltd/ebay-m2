<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ghostfrog_ebayledger_templates.ghostfrog_ebayledger_templates_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add Parts Template</label>
            </button>
        </buttons>
        <spinner>ghostfrog_ebayledger_templates_columns</spinner>
        <deps>
            <dep>ghostfrog_ebayledger_templates.ghostfrog_ebayledger_templates_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ghostfrog_ebayledger_templates_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">template_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>GhostFrog_EbayLedger::parts_templates</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="ghostfrog_ebayledger_templates_data_source">
            <settings>
                <requestFieldName>template_id</requestFieldName>
                <primaryFieldName>template_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="ghostfrog_ebayledger_templates_columns">
        <column name="template_id" sortOrder="10">
            <settings>
                <sorting>asc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="model_keys" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Model Keys</label>
            </settings>
        </column>
        <column name="parts" sortOrder="40">
            <settings>
                <label translate="true">Parts</label>
            </settings>
        </column>
        <column name="active" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Active</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="GhostFrog\EbayLedger\Ui\Component\Column\TemplateActions" sortOrder="900">
            <settings>
                <indexField>template_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
