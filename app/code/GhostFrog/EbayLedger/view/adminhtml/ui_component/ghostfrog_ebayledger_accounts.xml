<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ghostfrog_ebayledger_accounts.ghostfrog_ebayledger_accounts_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add eBay Account</label>
            </button>
        </buttons>
        <spinner>ghostfrog_ebayledger_accounts_columns</spinner>
        <deps>
            <dep>ghostfrog_ebayledger_accounts.ghostfrog_ebayledger_accounts_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ghostfrog_ebayledger_accounts_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">account_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>GhostFrog_EbayLedger::accounts</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="ghostfrog_ebayledger_accounts_data_source">
            <settings>
                <requestFieldName>account_id</requestFieldName>
                <primaryFieldName>account_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="ghostfrog_ebayledger_accounts_columns">
        <column name="account_id" sortOrder="10">
            <settings>
                <sorting>asc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="label" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="ebay_username" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">eBay User</label>
            </settings>
        </column>
        <column name="role" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="GhostFrog\EbayLedger\Model\Account\Role"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Role</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="GhostFrog\EbayLedger\Model\Account\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Connection</label>
            </settings>
        </column>
        <column name="enabled" component="Magento_Ui/js/grid/columns/select" sortOrder="55">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <dataType>select</dataType>
                <label translate="true">Imports</label>
            </settings>
        </column>
        <column name="access_expires_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="60">
            <settings>
                <dataType>date</dataType>
                <dateFormat>yyyy-MM-dd HH:mm</dateFormat>
                <label translate="true">Access Token Expires</label>
            </settings>
        </column>
        <column name="refresh_expires_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="70">
            <settings>
                <dataType>date</dataType>
                <dateFormat>yyyy-MM-dd</dateFormat>
                <label translate="true">Connection Expires</label>
            </settings>
        </column>
        <column name="stock_units" sortOrder="80">
            <settings>
                <label translate="true">Stock Units</label>
            </settings>
        </column>
        <column name="purchases_imported_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <dataType>date</dataType>
                <dateFormat>yyyy-MM-dd HH:mm</dateFormat>
                <label translate="true">Purchases Imported</label>
            </settings>
        </column>
        <column name="last_import_status" sortOrder="100">
            <settings>
                <label translate="true">Last Import</label>
            </settings>
        </column>
        <column name="last_import_message" sortOrder="110">
            <settings>
                <label translate="true">Last Import Message</label>
            </settings>
        </column>
        <column name="last_error" sortOrder="120">
            <settings>
                <label translate="true">Connection Error</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="GhostFrog\EbayLedger\Ui\Component\Column\AccountActions" sortOrder="900">
            <settings>
                <indexField>account_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
