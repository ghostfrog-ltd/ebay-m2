<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ghostfrog_ebayledger_stock_unit_form.ghostfrog_ebayledger_stock_unit_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Stock Unit</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="GhostFrog\EbayLedger\Block\Adminhtml\StockUnit\BackButton"/>
            <button name="save" class="GhostFrog\EbayLedger\Block\Adminhtml\StockUnit\SaveButton"/>
        </buttons>
        <namespace>ghostfrog_ebayledger_stock_unit_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>ghostfrog_ebayledger_stock_unit_form.ghostfrog_ebayledger_stock_unit_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ghostfrog_ebayledger_stock_unit_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="ghostfrog_ledger/stockunit/save"/>
        </settings>
        <aclResource>GhostFrog_EbayLedger::stock_units</aclResource>
        <dataProvider class="GhostFrog\EbayLedger\Model\StockUnit\DataProvider" name="ghostfrog_ebayledger_stock_unit_form_data_source">
            <settings>
                <requestFieldName>stock_unit_id</requestFieldName>
                <primaryFieldName>stock_unit_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="purchase">
        <settings>
            <label translate="true">Purchase</label>
        </settings>
        <field name="stock_unit_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>stock_unit_id</dataScope>
            </settings>
        </field>
        <field name="reference" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Reference</label>
                <notice translate="true">Paste this into the eBay listing's Custom label (SKU) when you sell it whole.</notice>
                <disabled>true</disabled>
                <dataScope>reference</dataScope>
            </settings>
        </field>
        <field name="title" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">eBay Title</label>
                <disabled>true</disabled>
                <dataScope>title</dataScope>
            </settings>
        </field>
        <field name="status_label" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Status</label>
                <disabled>true</disabled>
                <dataScope>status_label</dataScope>
            </settings>
        </field>
        <field name="purchased_at" formElement="input" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Bought (UTC)</label>
                <disabled>true</disabled>
                <dataScope>purchased_at</dataScope>
            </settings>
        </field>
        <field name="cost_summary" formElement="input" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">What It Cost</label>
                <disabled>true</disabled>
                <dataScope>cost_summary</dataScope>
            </settings>
        </field>
        <field name="prediction_summary" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">GhostFrog Predicted</label>
                <disabled>true</disabled>
                <dataScope>prediction_summary</dataScope>
            </settings>
        </field>
        <field name="purchase_method" formElement="select" sortOrder="70">
            <settings>
                <dataType>text</dataType>
                <label translate="true">How Bought</label>
                <notice translate="true">Change it if this is wrong; imports will then leave it alone.</notice>
                <dataScope>purchase_method</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="GhostFrog\EbayLedger\Model\StockUnit\PurchaseMethod"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="inspection">
        <settings>
            <label translate="true">Receive and Inspect</label>
        </settings>
        <field name="received_at" formElement="date" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Date Received</label>
                <notice translate="true">Leave empty until it arrives.</notice>
                <dataScope>received_at</dataScope>
            </settings>
            <formElements>
                <date>
                    <settings>
                        <inputDateFormat>y-MM-dd</inputDateFormat>
                        <outputDateFormat>y-MM-dd</outputDateFormat>
                    </settings>
                </date>
            </formElements>
        </field>
        <field name="actual_grade" formElement="select" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Actual Grade</label>
                <notice translate="true">Compared with GhostFrog's predicted grade to measure how accurate it is.</notice>
                <dataScope>actual_grade</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="GhostFrog\EbayLedger\Model\StockUnit\Grade"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="contents" formElement="textarea" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">What Arrived</label>
                <notice translate="true">One part per line, such as Console, Dock, Joy-Con pair, Power adapter, HDMI cable, Box.</notice>
                <dataScope>contents</dataScope>
            </settings>
        </field>
        <field name="faults" formElement="textarea" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Faults Found</label>
                <dataScope>faults</dataScope>
            </settings>
        </field>
        <field name="notes" formElement="textarea" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Notes</label>
                <dataScope>notes</dataScope>
            </settings>
        </field>
        <field name="photos" formElement="fileUploader" sortOrder="60">
            <settings>
                <label translate="true">Photos</label>
                <componentType>fileUploader</componentType>
                <dataScope>photos</dataScope>
            </settings>
            <formElements>
                <fileUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg png gif webp</allowedExtensions>
                        <maxFileSize>15728640</maxFileSize>
                        <isMultipleFiles>true</isMultipleFiles>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">ghostfrog_ledger/stockunit/upload</param>
                        </uploaderConfig>
                    </settings>
                </fileUploader>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="outcome_group">
        <settings>
            <label translate="true">Keep, Return or Write Off</label>
        </settings>
        <field name="outcome" formElement="select" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">What Happens to It</label>
                <dataScope>outcome</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="GhostFrog\EbayLedger\Model\StockUnit\Outcome"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="refund_amount" formElement="input" sortOrder="20">
            <settings>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-not-negative-number" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Refund from Seller (GBP)</label>
                <notice translate="true">Any money the seller or eBay gave back, full or partial. It comes off the cost.</notice>
                <dataScope>refund_amount</dataScope>
            </settings>
        </field>
        <field name="refunded_at" formElement="date" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Refund Date</label>
                <dataScope>refunded_at</dataScope>
            </settings>
            <formElements>
                <date>
                    <settings>
                        <inputDateFormat>y-MM-dd</inputDateFormat>
                        <outputDateFormat>y-MM-dd</outputDateFormat>
                    </settings>
                </date>
            </formElements>
        </field>
    </fieldset>
</form>
