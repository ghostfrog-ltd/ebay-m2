<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ghostfrog_ebayledger_sales.ghostfrog_ebayledger_sales_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="import">
                <url path="ghostfrog_ledger/sale/import"/>
                <class>primary</class>
                <label translate="true">Import Sales Now</label>
            </button>
        </buttons>
        <spinner>ghostfrog_ebayledger_sales_columns</spinner>
        <deps>
            <dep>ghostfrog_ebayledger_sales.ghostfrog_ebayledger_sales_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ghostfrog_ebayledger_sales_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">sale_line_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>GhostFrog_EbayLedger::sales</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="ghostfrog_ebayledger_sales_data_source">
            <settings>
                <requestFieldName>sale_line_id</requestFieldName>
                <primaryFieldName>sale_line_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <exportButton name="export_button"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="ghostfrog_ebayledger_sales_columns">
        <column name="sold_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="10">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <dateFormat>yyyy-MM-dd HH:mm</dateFormat>
                <sorting>desc</sorting>
                <label translate="true">Sold</label>
            </settings>
        </column>
        <column name="account_id" component="Magento_Ui/js/grid/columns/select" sortOrder="20">
            <settings>
                <options class="GhostFrog\EbayLedger\Model\Account\Options"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Account</label>
            </settings>
        </column>
        <column name="title" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">eBay Title</label>
            </settings>
        </column>
        <column name="sku" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Custom Label</label>
            </settings>
        </column>
        <column name="match_status" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="GhostFrog\EbayLedger\Model\Sale\MatchStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Match</label>
            </settings>
        </column>
        <column name="matched_sku" sortOrder="60">
            <settings>
                <label translate="true">Product</label>
            </settings>
        </column>
        <column name="match_note" sortOrder="70">
            <settings>
                <label translate="true">Why</label>
            </settings>
        </column>
        <column name="line_price" sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Price</label>
            </settings>
        </column>
        <column name="postage" sortOrder="90">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Postage</label>
            </settings>
        </column>
        <column name="refunded" sortOrder="100">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Refunded</label>
            </settings>
        </column>
        <column name="order_increment_id" sortOrder="110">
            <settings>
                <label translate="true">Magento Order</label>
            </settings>
        </column>
        <column name="fulfillment_status" sortOrder="120">
            <settings>
                <filter>text</filter>
                <label translate="true">eBay Dispatch</label>
            </settings>
        </column>
        <column name="payment_status" sortOrder="130">
            <settings>
                <filter>text</filter>
                <label translate="true">eBay Payment</label>
            </settings>
        </column>
        <column name="ebay_order_id" sortOrder="140">
            <settings>
                <filter>text</filter>
                <label translate="true">eBay Order</label>
            </settings>
        </column>
        <column name="last_error" sortOrder="150">
            <settings>
                <label translate="true">Error</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="GhostFrog\EbayLedger\Ui\Component\Column\SaleActions" sortOrder="900">
            <settings>
                <indexField>sale_line_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
